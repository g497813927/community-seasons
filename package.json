{
  "name": "community-seasons-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "npm ci --ignore-scripts && npm ci --prefix src",
    "dev": "npm --prefix src run dev",
    "build": "npm --prefix src run build",
    "test": "node scripts/test.mjs",
    "test:fuzz": "node run.mjs quick",
    "test:stress": "node run.mjs full --forever",
    "test:types": "tsc -p work/property-tests/typed-arbitraries.tsconfig.json",
    "qa:android": "node qa/web/run.mjs --platform android",
    "qa:build": "vite build qa/preview --config qa/preview/vite.config.ts",
    "qa:serve": "vite qa/preview --config qa/preview/vite.config.ts",
    "qa:web": "node qa/web/run.mjs --platform web",
    "qa:ios": "node qa/web/run.mjs --platform ios",
    "qa:all": "node qa/web/run.mjs --platform all",
    "qa:device": "node qa/devices/cli.mjs",
    "qa:test": "node --test qa/tests/*.test.mjs qa/devices/*.test.mjs",
    "qa:archive:licenses:serve": "vite qa/archive/licenses-ui-qa --config qa/archive/licenses-ui-qa/vite.config.ts",
    "qa:archive:licenses": "node qa/archive/licenses-ui-qa/check.mjs",
    "qa:archive:android:serve": "vite qa/archive/android-large-text-qa --config qa/archive/android-large-text-qa/vite.config.ts",
    "qa:archive:android": "node qa/archive/android-large-text-qa/check.mjs",
    "qa:archive:phone:build": "vite build qa/archive/phone-cart-fix-qa --config qa/archive/phone-cart-fix-qa/vite.config.ts",
    "qa:archive:iphone:build": "vite build qa/archive/iphone-qa --config qa/archive/iphone-qa/vite.config.ts",
    "qa:preview": "vite preview qa/preview --config qa/preview/vite.config.ts --port 4175 --strictPort"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "@vitejs/plugin-react": "6.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "playwright": "1.62.1"
  }
}
