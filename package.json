{
  "name": "community-seasons-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "npm ci --ignore-scripts && npm ci --prefix src",
    "dev": "npm --prefix src run dev",
    "build": "npm --prefix src run build",
    "test": "node tests/unit/run.mjs",
    "test:fuzz": "node tests/fuzz/run.mjs quick",
    "test:stress": "node tests/fuzz/run.mjs full --forever",
    "test:types": "tsc -p tests/property/typed-arbitraries.tsconfig.json",
    "qa:android": "node tests/qa/web/run.mjs --platform android",
    "qa:build": "vite build tests/qa/preview --config tests/qa/preview/vite.config.ts",
    "qa:serve": "vite tests/qa/preview --config tests/qa/preview/vite.config.ts",
    "qa:web": "node tests/qa/web/run.mjs --platform web",
    "qa:ios": "node tests/qa/web/run.mjs --platform ios",
    "qa:all": "node tests/qa/web/run.mjs --platform all",
    "qa:responsive": "node tests/qa/web/responsive.mjs",
    "qa:leaderboard": "node tests/qa/web/leaderboard.mjs",
    "qa:skins": "node tests/qa/web/skins.mjs",
    "qa:outfit:build": "vite build tests/qa/outfit-matrix --config tests/qa/outfit-matrix/vite.config.ts",
    "qa:outfits": "node tests/qa/web/outfit-matrix.mjs",
    "qa:device": "node tests/qa/devices/cli.mjs",
    "qa:test": "node --test tests/qa/tests/*.test.mjs tests/qa/devices/*.test.mjs scripts/vercel-qa.test.mjs",
    "qa:archive:licenses:serve": "vite tests/qa/archive/licenses-ui-qa --config tests/qa/archive/licenses-ui-qa/vite.config.ts",
    "qa:archive:licenses": "node tests/qa/archive/licenses-ui-qa/check.mjs",
    "qa:archive:android:serve": "vite tests/qa/archive/android-large-text-qa --config tests/qa/archive/android-large-text-qa/vite.config.ts",
    "qa:archive:android": "node tests/qa/archive/android-large-text-qa/check.mjs",
    "qa:archive:phone:build": "vite build tests/qa/archive/phone-cart-fix-qa --config tests/qa/archive/phone-cart-fix-qa/vite.config.ts",
    "qa:archive:iphone:build": "vite build tests/qa/archive/iphone-qa --config tests/qa/archive/iphone-qa/vite.config.ts",
    "qa:preview": "vite preview tests/qa/preview --config tests/qa/preview/vite.config.ts --port 4175 --strictPort",
    "qa:deploy": "node scripts/vercel-qa.mjs",
    "qa:share": "node scripts/vercel-qa.mjs share"
  },
  "devDependencies": {
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "@vitejs/plugin-react": "6.0.2",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "playwright": "1.62.1"
  }
}
