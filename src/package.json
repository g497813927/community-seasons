{
  "name": "community-seasons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "npm run questions:validate && npm run licenses:check && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "questions:sync": "node scripts/question-bank.mjs --write",
    "questions:validate": "node scripts/question-bank.mjs --check",
    "licenses:generate": "node scripts/licenses.mjs --write",
    "licenses:check": "node scripts/licenses.mjs --check",
    "predev": "npm run questions:sync",
    "prebuild": "npm run questions:sync && npm run licenses:generate"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "shadcn": "4.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
}
